{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "wordinkapp",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "hjjdnbftdwswkfqnsejt.supabase.co"
      ]
    }
  },
  "settings": {
    "global": {
      "supabaseUrl": {
        "type": "string",
        "label": "The website's Supabase project URL",
        "defaultValue": "https://hjjdnbftdwswkfqnsejt.supabase.co"
      },
      "supabaseAnonKey": {
        "type": "string",
        "label": "The website's Supabase anon key -- never the service-role key",
        "isSecret": true
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Post today's puzzle",
        "description": "Put up the WordInk post for today, if it has none yet",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "importWebsiteBoard": {
        "endpoint": "/internal/scheduler/import",
        "cron": "*/15 * * * *"
      },
      "dailyPuzzlePost": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "5 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "wordinkapp_dev"
  }
}
