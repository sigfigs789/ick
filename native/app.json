{
  "expo": {
    "name": "WordInk",
    "slug": "wordink",
    "owner": "sigfigs789",
    "scheme": "wordink",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fafafa",
    "primaryColor": "#1a1a1b",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafa"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "apiOrigin": "https://www.wordink.app",
      "eas": {
        "projectId": "2a165258-630c-4925-98f3-3e33ca6247d7"
      }
    },
    "ios": {
      "bundleIdentifier": "app.wordink",
      "buildNumber": "17",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.wordink",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fafafa"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": []
    },
    "plugins": [
      "expo-sqlite"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/2a165258-630c-4925-98f3-3e33ca6247d7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
