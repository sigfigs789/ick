# Merriam-Webster Dictionary API keys, used by api/validate.ts to check words
# that are missing from the curated list. Free non-commercial keys from
# https://dictionaryapi.com/ -- each is limited to 1,000 requests per day, which
# is why /api/validate responses are CDN-cached for 24h.
#
# These are read server-side only and are never exposed to the browser. Set the
# same two names in the Vercel project's environment variables. With neither set,
# the endpoint returns 503 "unconfigured" and the fallback is simply inert.
MW_COLLEGIATE_KEY=
MW_MEDICAL_KEY=
