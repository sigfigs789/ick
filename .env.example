# Merriam-Webster Dictionary API keys, used by api/validate.ts to check words
# that are missing from the curated list. Free non-commercial keys from
# https://dictionaryapi.com/ -- each is limited to 1,000 requests per day, which
# is why /api/validate responses are CDN-cached for 24h.
#
# These are read server-side only and are never exposed to the browser. Set the
# same two names in the Vercel project's environment variables. With neither set,
# the endpoint returns 503 "unconfigured" and the fallback is simply inert.
MW_COLLEGIATE_KEY=
MW_MEDICAL_KEY=

# Supabase, used by api/validate.ts and api/events.ts to record the words the
# live lookup judges and mirror the game's analytics events. Optional: with
# these unset the writes are skipped and the game behaves exactly as before.
# Nothing reads these tables, so the game stays offline-first either way.
#
# SUPABASE_URL is the project URL (https://<ref>.supabase.co). The service-role
# key bypasses row-level security, so it is server-side only -- never give it a
# VITE_ prefix, which would ship it to the browser. Set both in the Vercel
# project's environment variables too. See supabase/migrations/ for the schema.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
